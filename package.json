{
  "name": "fines-adapter",
  "version": "0.1.0",
  "description": "Converts the Fines Charging public locations feed into the osm-charge-review interchange format",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "fines-adapter": "./src/cli.ts"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "verify": "pnpm lint && pnpm check && pnpm test"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
